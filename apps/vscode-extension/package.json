{
  "name": "clank-harness",
  "displayName": "Clank-Harness",
  "description": "A local-first, provider-agnostic coding agent harness for VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "freebuff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xNull-ops/agentdock.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agentdock.agentView",
    "onCommand:agentdock.open",
    "onCommand:agentdock.setApiKey",
    "onCommand:agentdock.clearApiKey",
    "onCommand:agentdock.validateProvider",
    "onCommand:agentdock.refreshModels",
    "onCommand:agentdock.manageProviders",
    "onCommand:agentdock.manageModes"
  ],
  "main": "./dist/extension.js",
  "dependencies": {
    "@freebuff/agent-core": "file:../../packages/agent-core",
    "@freebuff/agent-storage": "file:../../packages/storage",
    "@freebuff/checkpoints": "file:../../packages/checkpoints",
    "@freebuff/provider-openai-compatible": "file:../../packages/providers/openai-compatible",
    "@freebuff/workspace-tools": "file:../../packages/workspace-tools",
    "sql.js": "^1.12.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentdock.open",
        "title": "Clank: Open Chat"
      },
      {
        "command": "agentdock.setApiKey",
        "title": "Clank: Set API Key"
      },
      {
        "command": "agentdock.clearApiKey",
        "title": "Clank: Clear API Key"
      },
      {
        "command": "agentdock.validateProvider",
        "title": "Clank: Validate Provider"
      },
      {
        "command": "agentdock.refreshModels",
        "title": "Clank: Refresh Provider Models"
      },
      {
        "command": "agentdock.manageProviders",
        "title": "Clank: Manage Providers"
      },
      {
        "command": "agentdock.manageModes",
        "title": "Clank: Manage Agents / Modes"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentdock",
          "title": "Clank",
          "icon": "resources/agent.svg"
        }
      ]
    },
    "views": {
      "agentdock": [
        {
          "type": "webview",
          "id": "agentdock.agentView",
          "name": "Clank"
        }
      ]
    },
    "configuration": {
      "title": "Clank",
      "properties": {
        "agentdock.defaultMode": {
          "type": "string",
          "default": "ask",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "examples": ["ask", "plan", "implement", "orchestrate", "database-specialist"],
          "description": "Built-in or custom mode slug used when a new Agent Harness session starts."
        },
        "agentdock.defaultModel": {
          "type": "string",
          "default": "openai-compatible",
          "description": "Model id used when a new session starts. Configure the endpoint-specific id under Agent Harness › Provider: Model."
        },
        "agentdock.subagents.maxConcurrent": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum subagents that may run concurrently during one turn. Write-capable subagents are still serialized."
        },
        "agentdock.subagents.maxTotal": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum total subagents accepted during one parent turn."
        },
        "agentdock.subagents.maxDepth": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "Maximum delegation nesting depth. Increase to two for nested Orchestrate workflows."
        },
        "agentdock.provider.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible provider base URL, for example http://127.0.0.1:8000/v1. API keys are never stored here."
        },
        "agentdock.provider.id": {
          "type": "string",
          "default": "openai-compatible",
          "description": "Provider identifier used in session telemetry."
        },
        "agentdock.provider.name": {
          "type": "string",
          "default": "OpenAI Compatible",
          "description": "Human-readable provider name."
        },
        "agentdock.provider.model": {
          "type": "string",
          "default": "",
          "description": "Model sent to the provider. Leave empty to use the model selected in chat."
        },
        "agentdock.provider.supportsDeveloperRole": {
          "type": "boolean",
          "default": true,
          "description": "Whether the configured endpoint accepts developer messages."
        },
        "agentdock.provider.supportsParallelToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "Whether the configured endpoint accepts parallel_tool_calls."
        },
        "agentdock.provider.requiresAssistantReasoningReplay": {
          "type": "boolean",
          "default": false,
          "description": "Replay provider reasoning metadata on assistant messages, as required by MiniMax and some compatible endpoints."
        },
        "agentdock.provider.requiresAssistantFrameReplay": {
          "type": "boolean",
          "default": false,
          "description": "Replay safe opaque assistant fields from matching provider frames when an endpoint requires exact continuation."
        },
        "agentdock.provider.sendMaxTokensAs": {
          "type": "string",
          "default": "max_tokens",
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ],
          "description": "Wire field used for the output-token limit."
        },
        "agentdock.provider.headers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Non-secret custom HTTP headers. Authorization, Cookie, and API-key headers are rejected; use SecretStorage for the API key."
        }
      }
    }
  },
  "scripts": {
    "tokens": "node ../../scripts/build-design-tokens.mjs",
    "build:packages": "tsc -p ../../packages/agent-core/tsconfig.json && tsc -p ../../packages/checkpoints/tsconfig.json && tsc -p ../../packages/providers/openai-compatible/tsconfig.json && tsc -p ../../packages/workspace-tools/tsconfig.json && tsc -p ../../packages/storage/tsconfig.json",
    "compile": "npm run tokens && npm run build:packages && node ../../scripts/bundle-vscode-extension.mjs && tsc -p ./tsconfig.webview.json --noEmit && cp src/webview/styles.css src/webview/generated-tokens.css dist/webview/",
    "test": "bun test test",
    "smoke:bundle": "node ../../scripts/smoke-vscode-bundle.mjs",
    "watch": "tsc -p ./tsconfig.json --watch",
    "typecheck": "npm run build:packages && tsc -p ./tsconfig.json --noEmit && tsc -p ./tsconfig.webview.json --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
